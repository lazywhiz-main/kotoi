{
  "name": "kotoi",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~57.0.4",
    "expo-apple-authentication": "~57.0.0",
    "expo-auth-session": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "^57.0.0",
    "expo-sharing": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.4.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "prestart": "node scripts/check-node.mjs",
    "start": "expo start --offline",
    "start:online": "expo start",
    "android": "expo start --offline --android",
    "ios": "node scripts/ios-phone.mjs && expo start --offline --ios",
    "ios:air": "node scripts/ios-phone.mjs \"iPhone Air\" && expo start --offline --ios",
    "ios:air:online": "node scripts/ios-phone.mjs \"iPhone Air\" && expo start --ios",
    "ios:14plus": "node scripts/ios-phone.mjs \"iPhone 14 Plus\" && expo start --offline --ios",
    "ios:14plus:online": "node scripts/ios-phone.mjs \"iPhone 14 Plus\" && expo start --ios",
    "ios:online": "node scripts/ios-phone.mjs && expo start --ios",
    "web": "expo start --offline --web",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile preview",
    "build:android:store": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --latest --profile production",
    "mock:graphic-rec": "node scripts/graphic-rec-mock-server.mjs"
  },
  "private": true
}
