# ---- Expo client (public) ----
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---- Supabase Edge Functions (secrets, server-side only) ----
# supabase secrets set ... で設定。クライアントには絶対に含めない。
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- limits ----
DAILY_COST_LIMIT_USD=2.00

# ---- optional: video transcript (Supabase Edge secrets) ----
# Supabase Edge のデータセンター IP は YouTube に bot 判定され LOGIN_REQUIRED になることがあります。
# どちらか一方（または両方）を設定してください。
# YOUTUBE_TRANSCRIPT_SUPADATA_API_KEY=   # https://supadata.ai （推奨・有料）
# YOUTUBE_TRANSCRIPT_PROXY_URL=          # Webshare Residential 等 http://user:pass@host:port
