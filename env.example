# ---- Expo client (public) ----
# 【L1 運用】日常開発はローカル Supabase（supabase start）の URL/anon を入れる。
# TestFlight / 本番ビルドは EAS production の EXPO_PUBLIC_* を使う（.env に本番を入れない）。
# 詳細: docs/plan-environments-and-testers.md
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ふりかえり画面の開発用サンプル（履歴が2件未満のとき差し込み）。通常はオフ。
# EXPO_PUBLIC_REVIEW_DEV_MOCK=1

# RevenueCat（TestFlight / 実機。Expo Go では購入不可）
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxx

# ---- Supabase Edge Functions (secrets, server-side only) ----
# supabase secrets set ... で設定。クライアントには絶対に含めない。
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-5
# JSON 呼び出しでは thinking 無効が既定。戻す場合: adaptive
# ANTHROPIC_THINKING=disabled
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPENAI_API_KEY=sk-xxxxx
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# ---- limits ----
DAILY_COST_LIMIT_USD=2.00

# 到達トライアルの開発用状態切替（trial-dev-override）。
# 【本番 Supabase には設定しない】ローカル supabase start 時のみ:
# ALLOW_TRIAL_DEV_OVERRIDE=1

# RevenueCat Webhook（Authorization ヘッダと完全一致）
# REVENUECAT_WEBHOOK_AUTH=Bearer your-shared-secret

# 今日の問い cron（schedule-daily-questions）。未設定なら認証なし（本番では設定推奨）
# DAILY_QUESTION_CRON_AUTH=Bearer your-cron-secret

# ---- optional: graphic-rec mock (npm run mock:graphic-rec) ----
# GRAPHIC_REC_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium
# gpt-image-2 / gpt-image-1.5 共通: low|medium|high|auto（2 のみ auto）
# OPENAI_API_KEY=sk-xxxxx

# ---- optional: video transcript ----
# YouTube字幕取得の実装に応じて設定（無料ライブラリ利用なら不要）
# YOUTUBE_API_KEY=
